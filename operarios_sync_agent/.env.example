SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=clave-privada-solo-para-el-agente

DATALAKE_SERVER=172.16.10.10
DATALAKE_DATABASE=DataLakeSCCZ
DATALAKE_USER=usuario_de_servicio
DATALAKE_PASSWORD=contraseña_de_servicio
DATALAKE_DRIVER=ODBC Driver 18 for SQL Server
DATALAKE_ENCRYPT=yes

# Intervalo para recoger solicitudes manuales desde la aplicación web.
POLL_SECONDS=60

# Control HTTP local. Por seguridad se enlaza solo al propio servidor.
# Para permitir acceso desde la red corporativa, usar AGENT_BIND_HOST=0.0.0.0
# y restringir el puerto en el firewall a las IPs autorizadas.
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8765
AGENT_API_TOKEN=crear_una_clave_larga_y_aleatoria
