SUPABASE_URL=https://tu-proyecto.supabase.co
# Sólo backend: crea una Secret key en Supabase > Settings > API Keys.
SUPABASE_KEY=sb_secret_tu_clave_de_servidor
# Clave pública (Publishable); se entrega al navegador sólo para Supabase Auth.
SUPABASE_ANON_KEY=sb_publishable_tu_clave_publica
SECRET_KEY=genera_una_clave_aleatoria_para_flask
# En Render se usa automáticamente RENDER_EXTERNAL_URL. Define APP_URL solo
# si empleas un dominio público personalizado.
APP_URL=http://localhost:5000

# Solo necesario para el acceso por numero de operario dentro de la red EMESA
DATALAKE_ENABLED=0
# Al activarlo debes rellenar todas las variables DATALAKE_* en el entorno,
# nunca en el código ni en Git.
DATALAKE_SERVER=
DATALAKE_DATABASE=
DATALAKE_USER=
DATALAKE_PASSWORD=
# Solo para SQL Server internos antiguos que no admiten TLS con ODBC 18.
DATALAKE_ENCRYPT=yes
# Activar solo después de migrar las cuentas de operario al nuevo modelo.
OPERARIOS_AUTH_SUPABASE_ONLY=0
