SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-secreta-de-supabase
SUPABASE_ANON_KEY=tu-clave-publica-de-supabase
SECRET_KEY=tu-clave-aleatoria-de-flask
APP_URL=http://localhost:5000

# Solo necesario para el acceso por numero de operario dentro de la red EMESA
DATALAKE_ENABLED=0
# Solo para SQL Server internos antiguos que no admiten TLS con ODBC 18.
DATALAKE_ENCRYPT=yes
# Activar solo después de migrar las cuentas de operario al nuevo modelo.
OPERARIOS_AUTH_SUPABASE_ONLY=0
